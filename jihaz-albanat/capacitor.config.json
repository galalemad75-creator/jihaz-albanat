{
  "appId": "com.jihaz.albanat",
  "appName": "جهاز البنات",
  "webDir": ".",
  "server": {
    "androidScheme": "https",
    "allowNavigation": ["*"]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#e91e63",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "light",
      "backgroundColor": "#e91e63"
    }
  },
  "android": {
    "allowMixedContent": true
  },
  "ios": {
    "contentInset": "automatic"
  }
}
